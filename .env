# Default values for every environment. Real secrets go in .env.local (never committed)
# or in real environment variables (production: see docker/.env.prod.example).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://ariane:ariane@127.0.0.1:5432/ariane?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

# Garage (S3 API). Only reachable on the internal Docker network.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_KEY=
S3_SECRET=
S3_BUCKET_QUARANTINE=quarantaine
S3_BUCKET_PUBLISHED=publie
# Public sub-domain used for short-lived presigned download URLs.
FILES_PUBLIC_URL=http://localhost:8000

# "clamav" (mandatory in production) or "none" (development only).
ANTIVIRUS_DRIVER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Leave empty to disable (text extraction is then limited to .txt files, no office preview).
TIKA_URL=
GOTENBERG_URL=

# HMAC key for the ALTCHA captcha.
ALTCHA_HMAC_KEY=
