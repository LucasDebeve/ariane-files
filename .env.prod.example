# Copy to .env.prod (never commit it) and fill every value.
# Generate secrets with: openssl rand -hex 32

APP_SECRET=
DEFAULT_URI=https://ariane.lucasdebeve.eu
TRUSTED_PROXIES=private_ranges

FILES_PUBLIC_URL=https://files.ariane.lucasdebeve.eu

POSTGRES_DB=ariane
POSTGRES_USER=ariane
POSTGRES_PASSWORD=

# Garage: RPC secret is 32 bytes hex. Key id = "GK" + 24 hex chars, secret = 64 hex chars:
#   S3_KEY=GK$(openssl rand -hex 12)   S3_SECRET=$(openssl rand -hex 32)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_CAPACITY=400G
S3_REGION=garage
S3_KEY=
S3_SECRET=
S3_BUCKET_QUARANTINE=quarantaine
S3_BUCKET_PUBLISHED=publie

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock
ALTCHA_HMAC_KEY=

# Backups (restic, to a second provider)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
