{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ 'access.title'|trans }}{% endblock %}

{% block body %}
<section class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
    <div class="hero-mesh grid items-center gap-10 px-6 py-12 sm:px-12 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
            <span class="bubble left-[4%] top-[8%] size-16">{{ ui.file_badge('pdf', 'size-11') }}</span>
            <span class="bubble bubble--slow bottom-[10%] left-[38%] hidden size-20 lg:flex [animation-delay:-4s]">{{ ui.file_badge('doc', 'size-14') }}</span>
            <span class="bubble right-[5%] top-[6%] hidden size-16 sm:flex [animation-delay:-6s]">{{ ui.file_badge('ppt', 'size-11') }}</span>
        </div>
        <div class="relative">
            <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{{ 'access.hero_title'|trans }}</h1>
            <p class="mt-4 w-fit max-w-md rounded-2xl bg-ink/45 px-5 py-3 text-lg font-semibold text-white backdrop-blur-sm">{{ 'access.hero_subtitle'|trans }}</p>
        </div>
        <div class="relative rounded-[var(--radius-card)] bg-white p-6 shadow-lift sm:p-8">
            <span class="flex size-12 items-center justify-center rounded-full bg-action/15 text-action-ink">{{ icons.icon('lock', 'size-6') }}</span>
            <h2 class="mt-4 text-xl font-extrabold">{{ 'access.form_title'|trans }}</h2>
            {% if not configured %}
                <p class="mt-3 rounded-2xl bg-sun/30 px-4 py-3 text-sm">{{ 'access.not_configured'|trans }}</p>
            {% endif %}
            {{ form_start(form, {attr: {class: 'mt-5'}}) }}
                {{ form_row(form.code) }}
                <button type="submit" class="btn btn-primary w-full py-3.5 text-base">{{ 'access.submit'|trans }} {{ icons.icon('arrow', 'size-5') }}</button>
            {{ form_end(form) }}
            <p class="mt-5 text-center text-sm text-muted">{{ 'access.certified'|trans }} <a href="{{ path('app_login') }}" class="font-bold text-ink underline decoration-action decoration-2 underline-offset-4">{{ 'nav.login'|trans }}</a></p>
        </div>
    </div>
</section>
{% endblock %}
