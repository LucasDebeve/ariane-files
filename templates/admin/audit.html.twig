{% extends 'admin/_layout.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}{{ 'admin.audit.title'|trans }}{% endblock %}

{% block admin_body %}
<h1 class="page-title">{{ 'admin.audit.title'|trans }}</h1>
<p class="mt-2 text-muted">{{ 'admin.audit.subtitle'|trans }}</p>
<div class="card mt-6 overflow-x-auto">
    <table class="w-full min-w-[48rem] text-left text-sm">
        <thead class="text-muted">
            <tr class="border-b border-line">
                <th scope="col" class="px-5 py-3 font-semibold">{{ 'admin.audit.col.date'|trans }}</th>
                <th scope="col" class="px-5 py-3 font-semibold">{{ 'admin.audit.col.actor'|trans }}</th>
                <th scope="col" class="px-5 py-3 font-semibold">{{ 'admin.audit.col.action'|trans }}</th>
                <th scope="col" class="px-5 py-3 font-semibold">{{ 'admin.audit.col.details'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for log in logs %}
            <tr class="border-b border-line/60 align-top last:border-0">
                <td class="whitespace-nowrap px-5 py-3 text-muted">{{ log.createdAt|format_datetime('short', 'medium', locale: 'fr') }}</td>
                <td class="px-5 py-3 font-semibold">{{ log.actorLabel }}</td>
                <td class="px-5 py-3">{{ ('audit.' ~ log.action)|trans }}{% if log.targetType %}<span class="block text-xs text-muted">{{ log.targetType }} {{ log.targetId|slice(0, 8) }}</span>{% endif %}</td>
                <td class="px-5 py-3 text-muted">
                    {% for key, value in log.details %}<span class="mr-2 inline-block"><span class="font-semibold">{{ key }}</span>: {{ value }}</span>{% endfor %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="px-5 py-10 text-center text-muted">{{ 'admin.audit.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<nav class="mt-6 flex justify-center gap-2">
    {% if page > 1 %}<a class="btn btn-ghost" href="{{ path('admin_audit', {page: page - 1}) }}">{{ icons.icon('back', 'size-4') }} {{ 'pagination.previous'|trans }}</a>{% endif %}
    {% if hasNext %}<a class="btn btn-ghost" href="{{ path('admin_audit', {page: page + 1}) }}">{{ 'pagination.next'|trans }} {{ icons.icon('arrow', 'size-4') }}</a>{% endif %}
</nav>
{% endblock %}
