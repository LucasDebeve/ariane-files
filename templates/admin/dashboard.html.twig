{% extends 'admin/_layout.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}

{% block admin_body %}
<h1 class="page-title">{{ 'admin.dashboard.title'|trans }}</h1>

<ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% set tiles = [
        {label: 'admin.dashboard.documents', value: documentCount, hint: publishedSize|bytes, icon: 'file', tone: 'bg-[#dfeaff]'},
        {label: 'admin.dashboard.downloads', value: downloads30, hint: 'admin.dashboard.last_30_days'|trans, icon: 'download', tone: 'bg-action/15'},
        {label: 'admin.dashboard.pending_requests', value: pendingRequests, hint: 'admin.dashboard.to_review'|trans, icon: 'clock', tone: 'bg-sun/40', link: path('certified_index')},
        {label: 'admin.dashboard.pending_users', value: pendingUsers, hint: 'admin.dashboard.to_approve'|trans, icon: 'users', tone: 'bg-coral/15', link: path('admin_users')},
    ] %}
    {% for tile in tiles %}
        <li class="card relative p-5">
            <span class="flex size-11 items-center justify-center rounded-full {{ tile.tone }}">{{ icons.icon(tile.icon, 'size-5') }}</span>
            <p class="mt-4 text-3xl font-extrabold tracking-tight">{{ tile.value|format_number(locale: 'fr') }}</p>
            <p class="text-sm font-semibold">{% if tile.link is defined %}<a href="{{ tile.link }}" class="after:absolute after:inset-0">{{ tile.label|trans }}</a>{% else %}{{ tile.label|trans }}{% endif %}</p>
            <p class="text-sm text-muted">{{ tile.hint }}</p>
        </li>
    {% endfor %}
</ul>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <section class="card p-6" aria-labelledby="chart-title">
        <h2 id="chart-title" class="font-extrabold">{{ 'admin.dashboard.daily'|trans }}</h2>
        <div class="mt-6 flex h-48 items-end gap-[3px]" role="img" aria-label="{{ 'admin.dashboard.daily_label'|trans({'%count%': downloads30}) }}">
            {% for day, count in daily %}
                <div class="group relative flex h-full flex-1 items-end">
                    <div class="w-full rounded-t-md {{ count > 0 ? 'bg-action' : 'bg-line' }} transition group-hover:bg-ink" style="height: {{ max(2, (count / dailyMax * 100)|round) }}%"></div>
                    <span class="pointer-events-none absolute -top-8 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-ink px-2 py-1 text-xs font-semibold text-white group-hover:block">{{ day|date('d/m') }} · {{ count }}</span>
                </div>
            {% endfor %}
        </div>
        <div class="mt-2 flex justify-between text-xs text-muted"><span>{{ daily|keys|first|date('d/m') }}</span><span>{{ daily|keys|last|date('d/m') }}</span></div>
    </section>

    <section class="card p-6" aria-labelledby="storage-title">
        <h2 id="storage-title" class="font-extrabold">{{ 'admin.dashboard.storage'|trans }}</h2>
        <dl class="mt-4 grid gap-4 text-sm">
            <div><dt class="text-muted">{{ 'admin.dashboard.stored'|trans }}</dt><dd class="text-xl font-extrabold">{{ storedSize|bytes }}</dd></div>
            <div>
                <dt class="text-muted">{{ 'admin.dashboard.quarantine'|trans }}</dt>
                <dd class="mt-1 font-semibold">{{ quarantineSize|bytes }} / {{ quarantineQuota|bytes }}</dd>
                <dd class="mt-2 h-2.5 overflow-hidden rounded-full bg-cream-deep"><div class="h-full rounded-full {{ quarantineSize / quarantineQuota > 0.8 ? 'bg-coral' : 'bg-action' }}" style="width: {{ max(1, (quarantineSize / quarantineQuota * 100)|round) }}%"></div></dd>
            </div>
        </dl>
    </section>
</div>

<section class="card mt-6 p-6" aria-labelledby="top-title">
    <h2 id="top-title" class="font-extrabold">{{ 'admin.dashboard.top'|trans }}</h2>
    {% if top is empty %}
        <p class="mt-4 text-sm text-muted">{{ 'admin.dashboard.no_downloads'|trans }}</p>
    {% else %}
        <ol class="mt-4 grid gap-2">
            {% for item in top %}
                <li class="flex items-center gap-4 rounded-2xl px-3 py-2 hover:bg-cream-deep">
                    <span class="w-6 text-right text-sm font-bold text-muted">{{ loop.index }}</span>
                    <a class="min-w-0 flex-1 truncate font-semibold hover:underline" href="{{ path('document_show', {id: item.id}) }}">{{ item.title }}</a>
                    <span class="pill">{{ icons.icon('download', 'size-3.5') }} {{ item.downloads }}</span>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</section>
{% endblock %}
