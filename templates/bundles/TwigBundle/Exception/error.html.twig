{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}{{ ('error.' ~ (status_code in [403, 404] ? status_code : 'generic') ~ '.title')|trans }}{% endblock %}

{% block header %}{% endblock %}

{% block body %}
{% set key = status_code in [403, 404] ? status_code : 'generic' %}
<div class="mx-auto max-w-3xl px-4 pt-10 sm:px-6">
    <div class="hero-mesh px-6 py-16 text-center sm:px-12">
        <p class="text-7xl font-extrabold tracking-tight text-white [text-shadow:0_2px_24px_rgb(19_32_63/0.3)] sm:text-8xl">{{ status_code }}</p>
        <h1 class="mt-4 text-2xl font-extrabold sm:text-3xl">{{ ('error.' ~ key ~ '.title')|trans }}</h1>
        <p class="mx-auto mt-3 w-fit max-w-md rounded-2xl bg-ink/45 px-4 py-2 font-semibold text-white">{{ ('error.' ~ key ~ '.text')|trans }}</p>
        <a href="{{ path('home') }}" class="btn btn-dark mt-8">{{ icons.icon('home', 'size-4') }} {{ 'error.home'|trans }}</a>
    </div>
</div>
{% endblock %}

{% block footer %}{% endblock %}
