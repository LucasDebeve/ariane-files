{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ document.title }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
    <nav aria-label="{{ 'breadcrumb.label'|trans }}" class="mb-6 text-sm">
        <ol class="flex flex-wrap items-center gap-1.5 text-muted">
            <li><a class="hover:text-ink" href="{{ path('folder_index') }}">{{ 'nav.folders'|trans }}</a></li>
            {% if document.folder %}
                {% for ancestor in document.folder.ancestors|merge([document.folder]) %}
                    <li aria-hidden="true">/</li>
                    <li><a class="hover:text-ink" href="{{ path('folder_show', {slug: ancestor.slug}) }}">{{ ancestor.name }}</a></li>
                {% endfor %}
            {% endif %}
        </ol>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="min-w-0">
            <div class="flex items-start gap-4">
                {{ ui.file_badge(document.videoLink ? 'video' : document.mimeType|file_family, 'size-14') }}
                <div class="min-w-0">
                    <h1 class="page-title break-words">{{ document.title }}</h1>
                    {% if document.tags is not empty %}
                        <ul class="mt-3 flex flex-wrap gap-2">
                            {% for tag in document.tags %}
                                <li><a class="chip" href="{{ path('document_index', {tag: tag.slug}) }}">#{{ tag.name }}</a></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
            {% if document.description %}
                <div class="prose-ariane mt-6 max-w-3xl whitespace-pre-line">{{ document.description }}</div>
            {% endif %}

            <section class="mt-8" aria-labelledby="preview-title">
                <h2 id="preview-title" class="sr-only">{{ 'document.preview'|trans }}</h2>
                <div class="rounded-[var(--radius-card)] bg-cream-deep p-3 sm:p-5">
                {% if preview.type == 'pdf' %}
                    <div data-controller="pdf-viewer"
                         data-pdf-viewer-url-value="{{ preview.url }}"
                         data-pdf-viewer-worker-value="{{ asset('lib/pdfjs/pdf.worker.min.mjs') }}"
                         data-error-message="{{ 'document.preview_error'|trans }}">
                        <p data-pdf-viewer-target="status" class="py-16 text-center text-muted">{{ 'document.preview_loading'|trans }}</p>
                        <div data-pdf-viewer-target="pages" class="max-h-[80vh] overflow-y-auto rounded-2xl"></div>
                    </div>
                {% elseif preview.type == 'image' %}
                    <img src="{{ preview.url }}" alt="{{ 'document.image_alt'|trans({'%title%': document.title}) }}" class="mx-auto max-h-[75vh] rounded-2xl bg-white object-contain" loading="lazy">
                {% elseif preview.type == 'text' %}
                    <pre class="max-h-[70vh] overflow-auto whitespace-pre-wrap rounded-2xl bg-white p-5 font-mono text-sm leading-relaxed text-ink-soft">{{ preview.text }}</pre>
                {% elseif preview.type == 'video' and preview.embed %}
                    <div class="aspect-video overflow-hidden rounded-2xl bg-ink">
                        <iframe src="{{ preview.embed }}" title="{{ document.title }}" class="size-full" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="encrypted-media; picture-in-picture; fullscreen" sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"></iframe>
                    </div>
                {% elseif preview.type == 'pending' %}
                    <p class="flex items-center justify-center gap-2 py-16 text-center text-muted">{{ icons.icon('clock', 'size-5') }} {{ 'document.preview_pending'|trans }}</p>
                {% else %}
                    <p class="py-16 text-center text-muted">{{ 'document.preview_none'|trans }}</p>
                {% endif %}
                </div>
            </section>
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
            <div class="card p-6">
                {% if document.videoLink %}
                    <a href="{{ document.externalUrl }}" class="btn btn-primary w-full py-3.5 text-base" target="_blank" rel="noopener noreferrer nofollow">{{ icons.icon('external', 'size-5') }} {{ 'document.open_video'|trans({'%platform%': document.externalUrl|video_platform}) }}</a>
                {% else %}
                    <a href="{{ path('document_download', {id: document.id}) }}" class="btn btn-primary w-full py-3.5 text-base" data-turbo="false">{{ icons.icon('download', 'size-5') }} {{ 'document.download'|trans }}</a>
                {% endif %}

                <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 text-sm">
                    {% if not document.videoLink %}
                        <dt class="text-muted">{{ 'document.file'|trans }}</dt><dd class="truncate font-semibold" title="{{ document.originalFilename }}">{{ document.originalFilename }}</dd>
                        <dt class="text-muted">{{ 'document.size'|trans }}</dt><dd class="font-semibold">{{ document.size|bytes }}</dd>
                    {% endif %}
                    <dt class="text-muted">{{ 'document.folder'|trans }}</dt><dd class="font-semibold">{{ document.folder ? document.folder.path : 'folder.root'|trans }}</dd>
                    <dt class="text-muted">{{ 'document.downloads_label'|trans }}</dt><dd class="font-semibold">{{ document.downloadCount }}</dd>
                    <dt class="text-muted">{{ 'document.updated'|trans }}</dt><dd class="font-semibold">{{ document.updatedAt|format_date('long', locale: 'fr') }}</dd>
                </dl>

                <hr class="my-6 border-line">
                <p class="text-sm font-semibold">{{ 'document.improve'|trans }}</p>
                {% if pendingChanges > 0 %}
                    <p class="mt-2 flex items-center gap-2 rounded-2xl bg-sun/30 px-3 py-2 text-sm">{{ icons.icon('clock', 'size-4 shrink-0') }} {{ 'document.pending_changes'|trans({'%count%': pendingChanges}) }}</p>
                {% endif %}
                <div class="mt-3 grid gap-2">
                    <a href="{{ path('proposal_edit', {id: document.id}) }}" class="btn btn-ghost w-full">{{ icons.icon('edit', 'size-4') }} {{ 'document.propose_edit'|trans }}</a>
                    <a href="{{ path('proposal_delete', {id: document.id}) }}" class="btn btn-danger w-full">{{ icons.icon('trash', 'size-4') }} {{ 'document.propose_delete'|trans }}</a>
                </div>
            </div>
        </aside>
    </div>
</div>
{% endblock %}
