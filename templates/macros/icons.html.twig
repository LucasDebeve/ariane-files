<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}" {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>{{ (paths[name] ?? paths.file)|raw }}</svg>
{%- endmacro %}

{# The Ariane mark: a thread unwinding from a ball of yarn. #}
{% macro logo(class = 'size-9') %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="{{ class }}" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="20" fill="#13203f"/>
    <circle cx="17" cy="18" r="8.5" fill="none" stroke="#00c566" stroke-width="2.2"/>
    <path d="M10.5 15.5c4-2 9-2 13 1M9.5 20c4.5-1.6 9.5-.8 13.5 2.4M12 24.5c3.3-.6 7-.1 10 1.6" fill="none" stroke="#00c566" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M24.5 23.5c2.5 2 3.5 4.5 6 5.5s3.5-1 2-2.5-4.5 1-3 4" fill="none" stroke="#ffd166" stroke-width="2" stroke-linecap="round"/>
</svg>
{% endmacro %}
