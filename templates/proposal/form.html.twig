{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ ('proposal.title.' ~ type.value)|trans }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 pt-10 sm:px-6">
    {% if document %}
        <a href="{{ path('document_show', {id: document.id}) }}" class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-muted hover:text-ink">{{ icons.icon('back', 'size-4') }} {{ document.title }}</a>
    {% endif %}
    <h1 class="page-title">{{ ('proposal.title.' ~ type.value)|trans }}</h1>
    <p class="mt-3 flex items-start gap-2 rounded-2xl bg-white px-4 py-3 text-sm text-ink-soft ring-1 ring-line">
        {{ icons.icon('shield', 'size-5 shrink-0 text-action-dark') }}
        <span>{{ 'proposal.intro'|trans }}</span>
    </p>

    <div class="card mt-8 p-6 sm:p-8">
        {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
            {{ form_errors(form) }}

            {% if type.value == 'suppression' %}
                <div class="mb-6 flex items-center gap-4 rounded-2xl bg-coral/10 p-4">
                    {{ ui.file_badge(document.videoLink ? 'video' : document.mimeType|file_family) }}
                    <p class="text-sm"><span class="block font-bold">{{ document.title }}</span><span class="text-muted">{{ 'proposal.deletion_notice'|trans }}</span></p>
                </div>
                {{ form_row(form.reason) }}
            {% else %}
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
                <div class="grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(form.folder) }}
                    {{ form_row(form.tags) }}
                </div>
                <fieldset class="mb-5 rounded-3xl bg-cream-deep/60 p-4 sm:p-5">
                    <legend class="sr-only">{{ 'proposal.form.content'|trans }}</legend>
                    {% if type.value == 'modification' %}
                        <p class="mb-4 text-sm text-muted">{{ 'proposal.form.content_unchanged'|trans }}</p>
                    {% endif %}
                    {{ form_row(form.file) }}
                    <p class="my-3 text-center text-xs font-bold uppercase tracking-widest text-muted">{{ 'proposal.form.or'|trans }}</p>
                    {{ form_row(form.videoUrl, {row_attr: {class: 'mb-0'}}) }}
                </fieldset>
                {% if form.reason is defined %}{{ form_row(form.reason) }}{% endif %}
            {% endif %}

            {{ form_row(form.proposerName) }}

            {% if needsCaptcha %}
                <div class="mb-6" data-controller="altcha" data-altcha-worker-value="{{ asset('lib/altcha/pbkdf2.js') }}">
                    <link rel="stylesheet" href="{{ asset('lib/altcha/altcha.css') }}">
                    <altcha-widget challenge="{{ path('captcha_challenge') }}" name="altcha" language="fr-fr" hidefooter auto="onfocus"></altcha-widget>
                </div>
            {% endif %}

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <a href="{{ document ? path('document_show', {id: document.id}) : path('home') }}" class="btn btn-ghost">{{ 'form.cancel'|trans }}</a>
                <button type="submit" class="btn {{ type.value == 'suppression' ? 'btn-dark' : 'btn-primary' }}">{{ icons.icon(type.value == 'suppression' ? 'trash' : 'upload', 'size-4') }} {{ 'proposal.submit'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
