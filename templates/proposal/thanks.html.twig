{% extends 'base.html.twig' %}
{% import 'macros/icons.html.twig' as icons %}

{% block title %}{{ 'proposal.thanks.title'|trans }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl px-4 pt-16 text-center sm:px-6">
    <span class="mx-auto flex size-20 items-center justify-center rounded-full bg-action text-ink shadow-lift">{{ icons.icon('check', 'size-10') }}</span>
    <h1 class="page-title mt-6">{{ 'proposal.thanks.title'|trans }}</h1>
    <p class="mx-auto mt-4 max-w-lg text-lg text-muted">{{ 'proposal.thanks.text'|trans }}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="{{ path('home') }}" class="btn btn-dark">{{ icons.icon('home', 'size-4') }} {{ 'proposal.thanks.home'|trans }}</a>
        <a href="{{ path('proposal_add') }}" class="btn btn-ghost">{{ icons.icon('plus', 'size-4') }} {{ 'proposal.thanks.again'|trans }}</a>
    </div>
</div>
{% endblock %}
